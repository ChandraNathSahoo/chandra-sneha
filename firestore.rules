rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /wishes/{wishId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasAll(['guestName', 'wishText', 'badgeText'])
        && request.resource.data.keys().hasOnly(['guestName', 'wishText', 'badgeText'])
        && request.resource.data.guestName is string
        && request.resource.data.guestName.size() > 0
        && request.resource.data.guestName.size() <= 100
        && request.resource.data.wishText is string
        && request.resource.data.wishText.size() > 0
        && request.resource.data.wishText.size() <= 500
        && request.resource.data.badgeText in ['উপস্থিত থাকব', 'শুভকামনা'];
      allow update, delete: if false;
    }
  }
}
